# Copy this file to .env and fill in your own values. Never commit .env.

PORT=3000

# MongoDB Atlas: Database > Connect > Drivers. Use a database user with access
# to this database only, and a password you don't use anywhere else.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=<AppName>
MONGODB_DB_NAME=jwt_auth_api
# Database used by npm test (its users are deleted on every run; must end in _test)
MONGODB_TEST_DB_NAME=jwt_auth_api_test

# Comma-separated list of frontend origins allowed to call the API (no trailing slash).
# Local Live Server, plus your deployed frontend, e.g. https://<user>.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Long random strings, different from each other. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=10m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# true on the public portfolio deployment: protects existing users from
# visitors (see src/config/demo.js and docs/DEMO_CREDENTIALS.md)
DEMO_MODE=false

# Login/register/refresh requests allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Set to 1 when the API runs behind a host's proxy (Render, Railway, Fly.io...)
TRUST_PROXY=
