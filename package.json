{
  "name": "jwt-auth-api",
  "version": "1.0.0",
  "description": "REST API with JWT auth, refresh tokens, role-based access and file uploads (Node.js, Express 5, MongoDB)",
  "main": "server.ts",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "tsc -p client",
    "start": "node server.ts",
    "dev": "node --watch --env-file-if-exists=.env server.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p client --noEmit",
    "build:client": "tsc -p client",
    "watch:client": "tsc -p client --watch",
    "seed": "node --env-file-if-exists=.env scripts/seedUsers.ts",
    "seed:reset": "node --env-file-if-exists=.env scripts/seedUsers.ts --reset",
    "demo:reset": "node --env-file-if-exists=.env scripts/resetDemo.ts",
    "create-manager": "node --env-file-if-exists=.env scripts/createManager.ts"
  },
  "keywords": [
    "express",
    "jwt",
    "mongodb",
    "mongoose",
    "authentication",
    "rbac"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "typescript": "^7.0.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/validator": "^13.15.10"
  }
}
