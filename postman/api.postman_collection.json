              "raw": "{\n  \"firstName\": \"Sara\",\n  \"lastName\": \"Hassan\",\n  \"email\": \"sara@example.com\",\n  \"phoneNumber\": \"01012345678\",\n  \"password\": \"Password123!\",\n  \"role\": \"user\"\n}",
              "options": {
