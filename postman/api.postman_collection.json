{
  "info": {
    "_postman_id": "2d7e9b4a-1c3f-4e8a-b5d6-7f8091a2b3c4",
    "name": "JWT Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the API (npm run dev) and add the demo users (npm run seed), then run **Auth → Login (manager)** first. It saves the tokens into collection variables, and every other request sends the access token automatically (collection Authorization tab).\n\nDemo accounts and roles: docs/DEMO_CREDENTIALS.md. Set `baseUrl` (Variables tab) to your deployed API to test it instead of localhost.\n\nAccess tokens expire after JWT_EXPIRES_IN (10m): when you get 401 \"Invalid or expired token\", run **Refresh token**."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Public. Is the API up and connected to the database? Also reports demoMode."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the tokens so every other request uses them",
                  "const data = pm.response.json().data;",
                  "if (data && data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah.mitchell@example.com\",\n  \"password\": \"DemoPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Manager created by scripts/createManager.js"
          }
        },
        {
          "name": "Register (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new user's id so Get / Update / Delete use it",
                  "const data = pm.response.json().data;",
                  "if (data && data.user) pm.collectionVariables.set('userId', data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ali\",\n  \"lastName\": \"Hassan\",\n  \"email\": \"ali@example.com\",\n  \"phoneNumber\": \"01012345678\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Everyone signs up as role \"user\". Tokens are returned but not saved, so you stay logged in as the manager."
          }
        },
        {
          "name": "Register (with avatar + PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new user's id so Get / Update / Delete use it",
                  "const data = pm.response.json().data;",
                  "if (data && data.user) pm.collectionVariables.set('userId', data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "Ali",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "Hassan",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "ali2@example.com",
                  "type": "text"
                },
                {
                  "key": "phoneNumber",
                  "value": "01012345678",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Password123!",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file"
                },
                {
                  "key": "document",
                  "type": "file"
                }
              ]
            },
            "description": "avatar: JPG/PNG/WEBP, document: PDF, max 5 MB each. Pick the files in the Body tab."
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the tokens so every other request uses them",
                  "const data = pm.response.json().data;",
                  "if (data && data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Deletes the saved refresh token. The access token still works until it expires."
          }
        }
      ]
    },
    {
